diff --git a/labs/hip-native/host/src/main.rs b/labs/hip-native/host/src/main.rs
new file mode 100644
index 00000000..545f918d
--- /dev/null
+++ b/labs/hip-native/host/src/main.rs
@@ -0,0 +1,492 @@
+mod selected;
+
+use std::ffi::{CStr, CString, c_char, c_void};
+use std::marker::PhantomData;
+use std::rc::Rc;
+
+unsafe extern "C" {
+    fn hipInit(flags: u32) -> i32;
+    fn hipSetDevice(device: i32) -> i32;
+    fn hipGetErrorString(error: i32) -> *const c_char;
+    fn hipModuleLoad(module: *mut *mut c_void, path: *const c_char) -> i32;
+    fn hipModuleGetFunction(
+        function: *mut *mut c_void,
+        module: *mut c_void,
+        name: *const c_char,
+    ) -> i32;
+    fn hipModuleUnload(module: *mut c_void) -> i32;
+    fn hipStreamCreate(stream: *mut *mut c_void) -> i32;
+    fn hipStreamSynchronize(stream: *mut c_void) -> i32;
+    fn hipStreamDestroy(stream: *mut c_void) -> i32;
+    fn hipMalloc(buffer: *mut *mut c_void, bytes: usize) -> i32;
+    fn hipFree(buffer: *mut c_void) -> i32;
+    fn hipMemcpyAsync(
+        dst: *mut c_void,
+        src: *const c_void,
+        bytes: usize,
+        kind: i32,
+        stream: *mut c_void,
+    ) -> i32;
+    fn hipModuleLaunchKernel(
+        function: *mut c_void,
+        gx: u32,
+        gy: u32,
+        gz: u32,
+        bx: u32,
+        by: u32,
+        bz: u32,
+        shared: u32,
+        stream: *mut c_void,
+        args: *mut *mut c_void,
+        extra: *mut *mut c_void,
+    ) -> i32;
+}
+
+fn checked(code: i32, op: &str) -> Result<(), String> {
+    if code == 0 {
+        return Ok(());
+    }
+    // SAFETY: HIP returns a static NUL-terminated string for every error code.
+    let text = unsafe { CStr::from_ptr(hipGetErrorString(code)) }.to_string_lossy();
+    Err(format!("{op}: {code}: {text}"))
+}
+
+struct Context {
+    module: *mut c_void,
+    stream: *mut c_void,
+    buffers: Vec<*mut c_void>,
+    // Module, stream and buffers stay on their creating thread.
+    _owner: PhantomData<Rc<()>>,
+}
+
+impl Context {
+    fn open(path: &str) -> Result<Self, String> {
+        let path = CString::new(path).map_err(|e| e.to_string())?;
+        let mut s = Self {
+            module: std::ptr::null_mut(),
+            stream: std::ptr::null_mut(),
+            buffers: Vec::new(),
+            _owner: PhantomData,
+        };
+        // SAFETY: output pointer storage and the C string remain live; Drop frees partial initialization.
+        unsafe {
+            checked(hipInit(0), "hipInit")?;
+            checked(hipSetDevice(0), "hipSetDevice")?;
+            checked(hipModuleLoad(&mut s.module, path.as_ptr()), "hipModuleLoad")?;
+            checked(hipStreamCreate(&mut s.stream), "hipStreamCreate")?;
+        }
+        Ok(s)
+    }
+    fn alloc(&mut self, bytes: usize) -> Result<*mut c_void, String> {
+        if bytes == 0 {
+            return Err("zero allocation refused".into());
+        }
+        let mut p = std::ptr::null_mut();
+        // SAFETY: p receives the allocation and this owner frees it exactly once.
+        unsafe {
+            checked(hipMalloc(&mut p, bytes), "hipMalloc")?;
+        }
+        self.buffers.push(p);
+        Ok(p)
+    }
+    fn function(&self, name: &str) -> Result<*mut c_void, String> {
+        let name = CString::new(name).map_err(|e| e.to_string())?;
+        let mut p = std::ptr::null_mut();
+        // SAFETY: the module is live and the name is a valid C string; function lives until module unload.
+        unsafe {
+            checked(
+                hipModuleGetFunction(&mut p, self.module, name.as_ptr()),
+                "hipModuleGetFunction",
+            )?;
+        }
+        Ok(p)
+    }
+    fn sync(&self) -> Result<(), String> {
+        // SAFETY: this owner exclusively uses the live stream.
+        unsafe { checked(hipStreamSynchronize(self.stream), "hipStreamSynchronize") }
+    }
+    fn launch(&self, f: *mut c_void, n: usize, args: &mut [*mut c_void]) -> Result<(), String> {
+        self.launch_shape(f, n.div_ceil(64), 64, args)
+    }
+    fn launch_shape(
+        &self,
+        f: *mut c_void,
+        blocks: usize,
+        threads: u32,
+        args: &mut [*mut c_void],
+    ) -> Result<(), String> {
+        let blocks = u32::try_from(blocks).map_err(|e| e.to_string())?;
+        // SAFETY: callers provide pointers to exact ABI argument storage and checked allocation sizes; synchronize before returning.
+        unsafe {
+            checked(
+                hipModuleLaunchKernel(
+                    f,
+                    blocks,
+                    1,
+                    1,
+                    threads,
+                    1,
+                    1,
+                    0,
+                    self.stream,
+                    args.as_mut_ptr(),
+                    std::ptr::null_mut(),
+                ),
+                "hipModuleLaunchKernel",
+            )?;
+        }
+        self.sync()
+    }
+    unsafe fn copy(
+        &self,
+        dst: *mut c_void,
+        src: *const c_void,
+        bytes: usize,
+        kind: i32,
+    ) -> Result<(), String> {
+        // SAFETY: caller ensures both allocations hold bytes and their lifetimes cover synchronization.
+        unsafe {
+            checked(
+                hipMemcpyAsync(dst, src, bytes, kind, self.stream),
+                "hipMemcpyAsync",
+            )?;
+        }
+        self.sync()
+    }
+}
+
+impl Drop for Context {
+    fn drop(&mut self) {
+        // SAFETY: all handles belong to this thread and are released once after its stream completes.
+        unsafe {
+            if !self.stream.is_null() {
+                hipStreamSynchronize(self.stream);
+            }
+            for &p in &self.buffers {
+                hipFree(p);
+            }
+            if !self.stream.is_null() {
+                hipStreamDestroy(self.stream);
+            }
+            if !self.module.is_null() {
+                hipModuleUnload(self.module);
+            }
+        }
+    }
+}
+
+fn shape(k: usize, rows: usize, cols: usize, weight_len: usize) -> Result<(usize, usize), String> {
+    if k == 0 || !k.is_multiple_of(256) || rows == 0 || cols == 0 {
+        return Err("positive dimensions, K multiple of 256 required".into());
+    }
+    for dim in [k, rows, cols] {
+        u32::try_from(dim).map_err(|e| e.to_string())?;
+    }
+    let need = (k / 256)
+        .checked_mul(144)
+        .and_then(|x| x.checked_mul(rows))
+        .ok_or("weight size overflow")?;
+    if weight_len != need {
+        return Err("weight byte count mismatch".into());
+    }
+    let nx = k
+        .checked_mul(cols)
+        .and_then(|x| x.checked_mul(4))
+        .ok_or("activation size overflow")?;
+    let ny = rows
+        .checked_mul(cols)
+        .and_then(|x| x.checked_mul(4))
+        .ok_or("output size overflow")?;
+    Ok((nx, ny))
+}
+
+fn fixture(k: usize, rows: usize) -> Vec<u8> {
+    let mut out = vec![0; k / 256 * rows * 144];
+    for (b, block) in out.as_chunks_mut::<144>().0.iter_mut().enumerate() {
+        block[..2].copy_from_slice(&0x1800_u16.to_le_bytes());
+        block[2..4].copy_from_slice(&0x1000_u16.to_le_bytes());
+        for (i, x) in block[4..].iter_mut().enumerate() {
+            *x = ((i * 29 + b * 13 + 17) % 256) as u8;
+        }
+    }
+    out
+}
+
+fn case(s: &mut Context, weights: &[u8], k: usize, rows: usize, cols: usize) -> Result<(), String> {
+    let (nx, ny) = shape(k, rows, cols, weights.len())?;
+    let x: Vec<f32> = (0..k * cols)
+        .map(|i| ((i as f32 * 0.013).sin() * 0.7) + (i % 11) as f32 * 0.01)
+        .collect();
+    let mut y = vec![0.0_f32; rows * cols];
+    let mut roundtrip = vec![0.0_f32; x.len()];
+    let w = s.alloc(weights.len())?;
+    let mut dx = s.alloc(nx)?;
+    let mut dy = s.alloc(ny)?;
+    let mut copy_out = s.alloc(nx)?;
+    // SAFETY: buffers match validated byte lengths, host vectors remain live and every transfer synchronizes.
+    unsafe {
+        s.copy(w, weights.as_ptr().cast(), weights.len(), 1)?;
+        s.copy(dx, x.as_ptr().cast(), nx, 1)?;
+    }
+    let cp = s.function("bloomery_hip_copy")?;
+    let mut n = u32::try_from(x.len()).map_err(|e| e.to_string())?;
+    let mut cp_args = [
+        (&mut dx as *mut *mut c_void).cast(),
+        (&mut copy_out as *mut *mut c_void).cast(),
+        (&mut n as *mut u32).cast(),
+    ];
+    s.launch(cp, x.len(), &mut cp_args)?;
+    // SAFETY: both copy buffers hold nx bytes and remain live through synchronization.
+    unsafe {
+        s.copy(roundtrip.as_mut_ptr().cast(), copy_out, nx, 2)?;
+    }
+    if !roundtrip
+        .iter()
+        .zip(&x)
+        .all(|(a, b)| a.to_bits() == b.to_bits())
+    {
+        return Err("Rust GPU copy roundtrip differs".into());
+    }
+    let f = s.function("bloomery_hip_q4_matmul")?;
+    let mut dw = w;
+    let (mut kk, mut rr, mut cc) = (k as u32, rows as u32, cols as u32);
+    let mut args = [
+        (&mut dw as *mut *mut c_void).cast(),
+        (&mut dx as *mut *mut c_void).cast(),
+        (&mut dy as *mut *mut c_void).cast(),
+        (&mut kk as *mut u32).cast(),
+        (&mut rr as *mut u32).cast(),
+        (&mut cc as *mut u32).cast(),
+    ];
+    let before = s.buffers.len();
+    for _ in 0..3 {
+        s.launch(f, y.len(), &mut args)?;
+    }
+    if s.buffers.len() != before {
+        return Err("steady launch allocated a GPU buffer".into());
+    }
+    // SAFETY: y and dy hold ny bytes and remain live through synchronization.
+    unsafe {
+        s.copy(y.as_mut_ptr().cast(), dy, ny, 2)?;
+    }
+    let mut decoded = vec![0.0_f32; k];
+    let mut error = 0.0_f64;
+    let mut norm = 0.0_f64;
+    let row_bytes = k / 256 * 144;
+    for row in 0..rows {
+        gguf::dequant_row(
+            gguf::GgmlType::Q4_K,
+            &weights[row * row_bytes..(row + 1) * row_bytes],
+            &mut decoded,
+        )
+        .map_err(|e| e.to_string())?;
+        for col in 0..cols {
+            let reference: f64 = decoded
+                .iter()
+                .zip(&x[col * k..(col + 1) * k])
+                .map(|(&a, &b)| f64::from(a) * f64::from(b))
+                .sum();
+            let got = f64::from(y[col * rows + row]);
+            if !got.is_finite() || !reference.is_finite() {
+                return Err("non-finite output or reference".into());
+            }
+            error += (got - reference).powi(2);
+            norm += reference.powi(2);
+        }
+    }
+    let nmse = error / norm.max(1e-30);
+    if !nmse.is_finite() || nmse > 1e-6 {
+        return Err(format!("NMSE {nmse} exceeds fixed 1e-6"));
+    }
+    println!(
+        "{{\"operation\":\"q4_matmul\",\"k\":{k},\"rows\":{rows},\"cols\":{cols},\"nmse\":{nmse},\"copy_equal\":true,\"steady_host_buffer_allocations\":0}}"
+    );
+    Ok(())
+}
+
+fn run() -> Result<(), String> {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    let path = args
+        .first()
+        .ok_or("usage: bloomery-hip-spike DEVICE_ELF [Q4_K_FILE K ROWS]")?;
+    if args.len() != 1 && args.len() != 4 {
+        return Err("expected DEVICE_ELF [Q4_K_FILE K ROWS]".into());
+    }
+    let mut s = Context::open(path)?;
+    for (k, rows, cols) in [(256, 7, 1), (512, 64, 1), (512, 64, 32)] {
+        case(&mut s, &fixture(k, rows), k, rows, cols)?;
+    }
+    if args.len() == 4 {
+        let weights = std::fs::read(&args[1]).map_err(|e| e.to_string())?;
+        let k = args[2].parse::<usize>().map_err(|e| e.to_string())?;
+        let rows = args[3].parse::<usize>().map_err(|e| e.to_string())?;
+        for cols in [1, 32] {
+            case(&mut s, &weights, k, rows, cols)?;
+        }
+        selected::real(&mut s, &weights, k, rows)?;
+    }
+    dense_ffn(&mut s)?;
+    selected::synthetic(&mut s)?;
+    Ok(())
+}
+
+fn dense_ffn(s: &mut Context) -> Result<(), String> {
+    const N: usize = 256;
+    let x: Vec<f32> = (0..N)
+        .map(|i| (i as f32 * 0.021).sin() * 0.4 - 0.2)
+        .collect();
+    let gamma: Vec<f32> = (0..N).map(|i| 0.8 + i as f32 * 0.001).collect();
+    let mut wg = fixture(N, N);
+    let mut wu = wg.clone();
+    let mut wd = wg.clone();
+    for (which, weights) in [&mut wg, &mut wu, &mut wd].iter_mut().enumerate() {
+        for (i, block) in weights.as_chunks_mut::<144>().0.iter_mut().enumerate() {
+            block[..2].copy_from_slice(&0x0c00_u16.to_le_bytes());
+            block[2..4].copy_from_slice(&0x0800_u16.to_le_bytes());
+            for byte in &mut block[16..] {
+                *byte = byte.wrapping_add((which * 19 + i % 13) as u8);
+            }
+        }
+    }
+    let mut dx = s.alloc(N * 4)?;
+    let mut dgamma = s.alloc(N * 4)?;
+    let mut norm = s.alloc(N * 4)?;
+    let mut gate = s.alloc(N * 4)?;
+    let mut up = s.alloc(N * 4)?;
+    let mut hidden = s.alloc(N * 4)?;
+    let mut out = s.alloc(N * 4)?;
+    let mut w = [s.alloc(wg.len())?, s.alloc(wu.len())?, s.alloc(wd.len())?];
+    // SAFETY: all host/device buffers have the exact lengths passed, and each copy synchronizes.
+    unsafe {
+        s.copy(dx, x.as_ptr().cast(), N * 4, 1)?;
+        s.copy(dgamma, gamma.as_ptr().cast(), N * 4, 1)?;
+        for (dst, source) in w.iter().zip([&wg, &wu, &wd]) {
+            s.copy(*dst, source.as_ptr().cast(), source.len(), 1)?;
+        }
+    }
+    let rms = s.function("bloomery_hip_rms_norm")?;
+    let mm = s.function("bloomery_hip_q4_matmul")?;
+    let act = s.function("bloomery_hip_swiglu")?;
+    let add = s.function("bloomery_hip_residual")?;
+    let (mut k, mut rows, mut cols, mut n) = (N as u32, N as u32, 1_u32, N as u32);
+    let mut eps = 1e-6_f32;
+    let before = s.buffers.len();
+    for _ in 0..3 {
+        let mut args = [
+            (&mut dx as *mut *mut c_void).cast(),
+            (&mut dgamma as *mut *mut c_void).cast(),
+            (&mut norm as *mut *mut c_void).cast(),
+            (&mut n as *mut u32).cast(),
+            (&mut eps as *mut f32).cast(),
+        ];
+        s.launch(rms, N, &mut args)?;
+        for (matrix, y) in [(0, &mut gate), (1, &mut up)] {
+            let mut args = [
+                (&mut w[matrix] as *mut *mut c_void).cast(),
+                (&mut norm as *mut *mut c_void).cast(),
+                (y as *mut *mut c_void).cast(),
+                (&mut k as *mut u32).cast(),
+                (&mut rows as *mut u32).cast(),
+                (&mut cols as *mut u32).cast(),
+            ];
+            s.launch(mm, N, &mut args)?;
+        }
+        let mut args = [
+            (&mut gate as *mut *mut c_void).cast(),
+            (&mut up as *mut *mut c_void).cast(),
+            (&mut hidden as *mut *mut c_void).cast(),
+            (&mut n as *mut u32).cast(),
+        ];
+        s.launch(act, N, &mut args)?;
+        let mut args = [
+            (&mut w[2] as *mut *mut c_void).cast(),
+            (&mut hidden as *mut *mut c_void).cast(),
+            (&mut out as *mut *mut c_void).cast(),
+            (&mut k as *mut u32).cast(),
+            (&mut rows as *mut u32).cast(),
+            (&mut cols as *mut u32).cast(),
+        ];
+        s.launch(mm, N, &mut args)?;
+        let mut args = [
+            (&mut dx as *mut *mut c_void).cast(),
+            (&mut out as *mut *mut c_void).cast(),
+            (&mut n as *mut u32).cast(),
+        ];
+        s.launch(add, N, &mut args)?;
+    }
+    if s.buffers.len() != before {
+        return Err("FFN steady launch issued a buffer allocation".into());
+    }
+    let mut got = vec![0.0_f32; N];
+    // SAFETY: got and out cover N*4 bytes; the copy synchronizes before got is read.
+    unsafe {
+        s.copy(got.as_mut_ptr().cast(), out, N * 4, 2)?;
+    }
+    let inverse = 1.0
+        / (x.iter().map(|&v| f64::from(v).powi(2)).sum::<f64>() / N as f64 + f64::from(eps)).sqrt();
+    let normalized: Vec<f64> = x
+        .iter()
+        .zip(&gamma)
+        .map(|(&v, &g)| f64::from(v) * inverse * f64::from(g))
+        .collect();
+    let matrix = |weights: &[u8], x: &[f64]| -> Result<Vec<f64>, String> {
+        let mut row = vec![0.0_f32; N];
+        let mut y = Vec::with_capacity(N);
+        for data in weights.as_chunks::<144>().0 {
+            gguf::dequant_row(gguf::GgmlType::Q4_K, data, &mut row).map_err(|e| e.to_string())?;
+            y.push(row.iter().zip(x).map(|(&a, &b)| f64::from(a) * b).sum());
+        }
+        Ok(y)
+    };
+    let gate_ref = matrix(&wg, &normalized)?;
+    let up_ref = matrix(&wu, &normalized)?;
+    let hidden_ref: Vec<f64> = gate_ref
+        .iter()
+        .zip(&up_ref)
+        .map(|(&g, &u)| g / (1.0 + (-g).exp()) * u)
+        .collect();
+    let reference = matrix(&wd, &hidden_ref)?;
+    let mut error = 0.0;
+    let mut energy = 0.0;
+    for ((actual, reference), &residual) in got.iter().zip(reference).zip(&x) {
+        let reference = reference + f64::from(residual);
+        if !actual.is_finite() || !reference.is_finite() {
+            return Err("FFN output or reference is nonfinite".into());
+        }
+        error += (f64::from(*actual) - reference).powi(2);
+        energy += reference.powi(2);
+    }
+    let nmse = error / energy.max(1e-30);
+    if !nmse.is_finite() || nmse > 1e-6 {
+        return Err(format!("FFN NMSE {nmse} exceeds fixed 1e-6"));
+    }
+    println!(
+        "{{\"operation\":\"dense_ffn\",\"width\":256,\"nmse\":{nmse},\"intermediate_host_copies\":0,\"steady_host_buffer_allocations\":0}}"
+    );
+    Ok(())
+}
+
+fn main() {
+    if let Err(e) = run() {
+        eprintln!("bloomery-hip-spike: {e}");
+        std::process::exit(1);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::shape;
+    #[test]
+    fn refuses_invalid_shapes_and_truncated_weights() {
+        for (k, r, c, w) in [
+            (0, 1, 1, 0),
+            (255, 1, 1, 144),
+            (256, 0, 1, 0),
+            (256, 1, 0, 144),
+            (256, 1, 1, 143),
+        ] {
+            assert!(shape(k, r, c, w).is_err());
+        }
+        assert_eq!(shape(256, 7, 32, 1008).unwrap(), (32768, 896));
+    }
+}
diff --git a/labs/hip-native/host/src/selected.rs b/labs/hip-native/host/src/selected.rs
new file mode 100644
index 00000000..8a6c0cdf
--- /dev/null
+++ b/labs/hip-native/host/src/selected.rs
@@ -0,0 +1,416 @@
+//! Selection and numerical contracts against the engine's existing scalar card-rule oracle.
+use super::{Context, c_void};
+
+const HOST: u32 = u32::MAX;
+const FAULT_WORDS: usize = 65_537;
+const SENTINEL: f32 = 1.0e30;
+
+struct Plan {
+    k: usize,
+    rows: usize,
+    experts: usize,
+    slots: usize,
+    cols: usize,
+}
+
+impl Plan {
+    fn validate(
+        &self,
+        weights: usize,
+        q: usize,
+        sums: usize,
+        scales: usize,
+        ids: usize,
+        out: usize,
+    ) -> Result<(), String> {
+        if !(256..=20_480).contains(&self.k)
+            || !self.k.is_multiple_of(256)
+            || self.rows == 0
+            || self.experts == 0
+            || self.slots == 0
+            || self.cols < self.slots
+        {
+            return Err("q4_selected: invalid shape or fewer activation columns than slots".into());
+        }
+        for dim in [self.rows, self.experts, self.slots, self.cols] {
+            u32::try_from(dim).map_err(|_| "q4_selected: dimension exceeds u32")?;
+        }
+        let n_sb = self.k / 256;
+        let product = |a: usize, b: usize| a.checked_mul(b).ok_or("q4_selected: size overflow");
+        let expected_weights = product(product(self.rows, self.experts)?, product(n_sb, 144)?)?;
+        if weights != expected_weights
+            || q < product(self.cols, 256 * n_sb.div_ceil(4))?
+            || sums < product(self.cols, 8 * n_sb)?
+            || scales < product(self.cols, 2 * n_sb)?
+            || ids < self.slots
+            || out < product(self.slots, self.rows)?
+        {
+            return Err("q4_selected: weight/plane/id/output span mismatch".into());
+        }
+        Ok(())
+    }
+}
+
+struct Planes {
+    q: Vec<u32>,
+    sums: Vec<i32>,
+    scales: Vec<f32>,
+    oracle: Vec<qdot::CardQ81>,
+}
+
+fn planes(values: &[f32], k: usize) -> Planes {
+    let n_sb = k / 256;
+    let width = 256 * n_sb.div_ceil(4);
+    let oracle: Vec<_> = values.chunks_exact(k).map(qdot::card_q8_1_scalar).collect();
+    // Padding remains poisoned: the partial final super-block group must never read it.
+    let mut q = vec![0xa5a5_a5a5; oracle.len() * width];
+    let mut sums = Vec::new();
+    let mut scales = Vec::new();
+    for (col, act) in oracle.iter().enumerate() {
+        for (v4, quad) in act.codes().as_chunks::<4>().0.iter().enumerate() {
+            let slot = 256 * (v4 >> 8) + 32 * (v4 & 7) + 8 * ((v4 >> 6) & 3) + ((v4 >> 3) & 7);
+            q[col * width + slot] = u32::from_le_bytes(quad.map(|v| v as u8));
+        }
+        sums.extend_from_slice(act.s8());
+        scales.extend_from_slice(act.d8());
+    }
+    Planes {
+        q,
+        sums,
+        scales,
+        oracle,
+    }
+}
+
+fn upload<T: Copy>(context: &mut Context, values: &[T]) -> Result<*mut c_void, String> {
+    let bytes = std::mem::size_of_val(values);
+    let ptr = context.alloc(bytes)?;
+    // SAFETY: both allocations cover bytes; the transfer synchronizes before values are dropped.
+    unsafe {
+        context.copy(ptr, values.as_ptr().cast(), bytes, 1)?;
+    }
+    Ok(ptr)
+}
+
+fn overwrite<T: Copy>(context: &Context, ptr: *mut c_void, values: &[T]) -> Result<(), String> {
+    // SAFETY: each caller passes the allocation made for this exact-length typed vector; copy synchronizes.
+    unsafe {
+        context.copy(
+            ptr,
+            values.as_ptr().cast(),
+            std::mem::size_of_val(values),
+            1,
+        )
+    }
+}
+
+fn read<T: Copy>(context: &Context, ptr: *mut c_void, values: &mut [T]) -> Result<(), String> {
+    // SAFETY: each caller passes the allocation made for this exact-length typed vector; copy synchronizes.
+    unsafe {
+        context.copy(
+            values.as_mut_ptr().cast(),
+            ptr,
+            std::mem::size_of_val(values),
+            2,
+        )
+    }
+}
+
+fn wave_size(context: &mut Context) -> Result<(), String> {
+    let mut word = [0u32];
+    let mut ptr = upload(context, &word)?;
+    let f = context.function("bloomery_hip_wave_size")?;
+    context.launch_shape(f, 1, 1, &mut [(&mut ptr as *mut *mut c_void).cast()])?;
+    read(context, ptr, &mut word)?;
+    if word != [32] {
+        return Err(format!(
+            "q4_selected: requires compiled wave32, got {}",
+            word[0]
+        ));
+    }
+    Ok(())
+}
+
+struct Device {
+    w: *mut c_void,
+    q: *mut c_void,
+    sums: *mut c_void,
+    scales: *mut c_void,
+    ids: *mut c_void,
+    fault: *mut c_void,
+    out: *mut c_void,
+    function: *mut c_void,
+}
+
+impl Device {
+    fn launch(&mut self, context: &Context, plan: &Plan, layer: u32) -> Result<(), String> {
+        if layer > 65_535 {
+            return Err("q4_selected: layer exceeds fault allocation".into());
+        }
+        let (mut experts, mut rows, mut slots, mut n_sb, mut iters, mut layer) = (
+            plan.experts as u32,
+            plan.rows as u32,
+            plan.slots as u32,
+            (plan.k / 256) as u32,
+            (plan.k / 256).div_ceil(4) as u32,
+            layer,
+        );
+        let mut args = [
+            (&mut self.w as *mut *mut c_void).cast(),
+            (&mut self.q as *mut *mut c_void).cast(),
+            (&mut self.sums as *mut *mut c_void).cast(),
+            (&mut self.scales as *mut *mut c_void).cast(),
+            (&mut self.ids as *mut *mut c_void).cast(),
+            (&mut experts as *mut u32).cast(),
+            (&mut rows as *mut u32).cast(),
+            (&mut slots as *mut u32).cast(),
+            (&mut n_sb as *mut u32).cast(),
+            (&mut iters as *mut u32).cast(),
+            (&mut self.fault as *mut *mut c_void).cast(),
+            (&mut layer as *mut u32).cast(),
+            (&mut self.out as *mut *mut c_void).cast(),
+        ];
+        context.launch_shape(
+            self.function,
+            (plan.slots * plan.rows).div_ceil(8),
+            256,
+            &mut args,
+        )
+    }
+}
+
+fn check_output(
+    plan: &Plan,
+    weights: &[u8],
+    acts: &Planes,
+    ids: &[u32],
+    got: &[f32],
+) -> Result<(), String> {
+    let row_bytes = plan.k / 256 * 144;
+    for (slot, &id) in ids.iter().enumerate() {
+        for row in 0..plan.rows {
+            let got = got[slot * plan.rows + row];
+            if id as usize >= plan.experts {
+                if got.to_bits() != SENTINEL.to_bits() {
+                    return Err(format!(
+                        "q4_selected: skipped slot {slot} row {row} changed sentinel"
+                    ));
+                }
+                continue;
+            }
+            let start = (id as usize * plan.rows + row) * row_bytes;
+            let expected = qdot::card_q4k_dot_row_scalar(
+                &weights[start..start + row_bytes],
+                &acts.oracle[slot],
+            )
+            .map_err(|e| e.to_string())?;
+            if acts.oracle[slot].refused_any() {
+                if !expected.is_nan() || !got.is_nan() {
+                    return Err(format!(
+                        "q4_selected: refused activation slot {slot} row {row} did not propagate NaN"
+                    ));
+                }
+            } else if !got.is_finite()
+                || !expected.is_finite()
+                || got.to_bits() != expected.to_bits()
+            {
+                return Err(format!(
+                    "q4_selected: K={} slot={slot} row={row} got={got} ({:08x}) expected={expected} ({:08x})",
+                    plan.k,
+                    got.to_bits(),
+                    expected.to_bits()
+                ));
+            }
+        }
+    }
+    Ok(())
+}
+
+fn case(
+    context: &mut Context,
+    weights: &[u8],
+    k: usize,
+    rows: usize,
+    experts: usize,
+    real: bool,
+) -> Result<(), String> {
+    let plan = Plan {
+        k,
+        rows,
+        experts,
+        slots: 6,
+        cols: 8,
+    };
+    let mut values: Vec<f32> = (0..k * plan.cols)
+        .map(|i| ((i as f32 * 0.019).sin() - 0.31) * ((i / k + 1) as f32 * 0.13))
+        .collect();
+    // Extra columns are legal but must not be read by any selected slot.
+    values[plan.slots * k..].fill(f32::NAN);
+    let ordinary = planes(&values, k);
+    let ids_a = [0, 2, 3, 2, 1, 0];
+    let ids_b = [3, 0, 1, 1, 2, 3];
+    let ids_bad = [2, HOST, experts as u32 + 7, 0, 1, 3];
+    let mut out = vec![SENTINEL; plan.slots * rows];
+    plan.validate(
+        weights.len(),
+        ordinary.q.len(),
+        ordinary.sums.len(),
+        ordinary.scales.len(),
+        ids_a.len(),
+        out.len(),
+    )?;
+    let mut fault = vec![0u32; FAULT_WORDS];
+    fault[0] = u32::MAX;
+    let mut device = Device {
+        w: upload(context, weights)?,
+        q: upload(context, &ordinary.q)?,
+        sums: upload(context, &ordinary.sums)?,
+        scales: upload(context, &ordinary.scales)?,
+        ids: upload(context, &ids_a)?,
+        fault: upload(context, &fault)?,
+        out: upload(context, &out)?,
+        function: context.function("bloomery_hip_q4_sel")?,
+    };
+    let allocated = context.buffers.len();
+    let mut runs = 0;
+    for ids in [&ids_a, &ids_a, &ids_a, &ids_b] {
+        out.fill(SENTINEL);
+        overwrite(context, device.ids, ids)?;
+        overwrite(context, device.out, &out)?;
+        device.launch(context, &plan, 9)?;
+        read(context, device.out, &mut out)?;
+        check_output(&plan, weights, &ordinary, ids, &out)?;
+        runs += 1;
+    }
+    read(context, device.fault, &mut fault)?;
+    if fault[0] != u32::MAX || fault[1..].iter().any(|&v| v != 0) {
+        return Err("q4_selected: valid selection raised a fault".into());
+    }
+    out.fill(SENTINEL);
+    overwrite(context, device.out, &out)?;
+    overwrite(context, device.ids, &ids_bad)?;
+    for layer in [9, 3, 9] {
+        device.launch(context, &plan, layer)?;
+        runs += 1;
+    }
+    read(context, device.out, &mut out)?;
+    check_output(&plan, weights, &ordinary, &ids_bad, &out)?;
+    read(context, device.fault, &mut fault)?;
+    if fault[0] != (3 << 8) | 7
+        || fault[4] != 1 << 7
+        || fault[10] != 1 << 7
+        || fault[1..]
+            .iter()
+            .enumerate()
+            .any(|(i, &v)| i != 3 && i != 9 && v != 0)
+    {
+        return Err(
+            "q4_selected: sticky earliest-layer fault word or per-layer site masks differ".into(),
+        );
+    }
+    // Isolate HOST from invalid ids: it must not raise a fault of its own.
+    let ids_host = [2, HOST, 3, 0, 1, 3];
+    fault.fill(0);
+    fault[0] = u32::MAX;
+    overwrite(context, device.fault, &fault)?;
+    overwrite(context, device.ids, &ids_host)?;
+    out.fill(SENTINEL);
+    overwrite(context, device.out, &out)?;
+    device.launch(context, &plan, 9)?;
+    runs += 1;
+    read(context, device.out, &mut out)?;
+    check_output(&plan, weights, &ordinary, &ids_host, &out)?;
+    // A NaN input is refused by the HOST oracle/quantizer here. This entry propagates the
+    // NaN scale; it does not pretend to have run the GPU quantizer or to raise its fault.
+    values[0] = f32::NAN;
+    values[k..2 * k].fill(0.0);
+    for (i, value) in values[2 * k..3 * k].iter_mut().enumerate() {
+        *value =
+            f32::from_bits(100_000 + (i % 17) as u32 * 37) * if i % 2 == 0 { 1.0 } else { -1.0 };
+    }
+    let refused = planes(&values, k);
+    overwrite(context, device.q, &refused.q)?;
+    overwrite(context, device.sums, &refused.sums)?;
+    overwrite(context, device.scales, &refused.scales)?;
+    overwrite(context, device.ids, &ids_a)?;
+    out.fill(SENTINEL);
+    overwrite(context, device.out, &out)?;
+    device.launch(context, &plan, 9)?;
+    runs += 1;
+    read(context, device.out, &mut out)?;
+    check_output(&plan, weights, &refused, &ids_a, &out)?;
+    read(context, device.fault, &mut fault)?;
+    if fault[0] != u32::MAX || fault[1..].iter().any(|&v| v != 0) {
+        return Err("q4_selected: HOST or NaN scale raised an unexpected expert-id fault".into());
+    }
+    if context.buffers.len() != allocated {
+        return Err("q4_selected: steady launch allocated".into());
+    }
+    println!(
+        "{{\"operation\":\"q4_selected\",\"contract\":\"selected_bitwise\",\"k\":{k},\"rows_per_expert\":{rows},\"experts\":{experts},\"slots\":6,\"activation_cols\":8,\"launches\":{runs},\"real_weights\":{real},\"wave_size\":32,\"bitwise_equal\":true,\"finite_expected_outputs\":true,\"nan_propagation\":true,\"fault_and_sentinel\":true,\"steady_host_buffer_allocations\":0}}"
+    );
+    Ok(())
+}
+
+pub(super) fn synthetic(context: &mut Context) -> Result<(), String> {
+    wave_size(context)?;
+    for (i, n_sb) in [1, 2, 3, 4, 5, 7, 8, 9, 11, 24, 80].into_iter().enumerate() {
+        let k = n_sb * 256;
+        let rows = 7 + i % 3;
+        case(context, &super::fixture(k, 4 * rows), k, rows, 4, false)?;
+    }
+    Ok(())
+}
+
+pub(super) fn real(
+    context: &mut Context,
+    weights: &[u8],
+    k: usize,
+    total_rows: usize,
+) -> Result<(), String> {
+    if total_rows < 4 || !total_rows.is_multiple_of(4) {
+        return Err("q4_selected: real fixture needs a positive multiple of four rows".into());
+    }
+    wave_size(context)?;
+    case(context, weights, k, total_rows / 4, 4, true)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn selected_shape_refusals_precede_the_driver() {
+        let mut plan = Plan {
+            k: 256,
+            rows: 7,
+            experts: 4,
+            slots: 6,
+            cols: 8,
+        };
+        let weights = 144 * 7 * 4;
+        assert!(plan.validate(weights, 8 * 256, 8 * 8, 8 * 2, 6, 42).is_ok());
+        for lengths in [
+            (weights - 1, 2048, 64, 16, 6, 42),
+            (weights, 2047, 64, 16, 6, 42),
+            (weights, 2048, 63, 16, 6, 42),
+            (weights, 2048, 64, 15, 6, 42),
+            (weights, 2048, 64, 16, 5, 42),
+            (weights, 2048, 64, 16, 6, 41),
+        ] {
+            assert!(
+                plan.validate(
+                    lengths.0, lengths.1, lengths.2, lengths.3, lengths.4, lengths.5
+                )
+                .is_err()
+            );
+        }
+        plan.cols = 5;
+        assert!(plan.validate(weights, 2048, 64, 16, 6, 42).is_err());
+        plan.cols = 8;
+        plan.rows = 0;
+        assert!(plan.validate(weights, 2048, 64, 16, 6, 42).is_err());
+        plan.rows = usize::MAX;
+        assert!(plan.validate(weights, 2048, 64, 16, 6, 42).is_err());
+    }
+}
