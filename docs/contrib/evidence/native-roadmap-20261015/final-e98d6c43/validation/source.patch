+    for text in ("listening on http://0.0.0.0:12345", "listening on http://127.0.0.1:0",
+                 "listening on http://127.0.0.1:99999", "listening on http://127.0.0.1:4\nlistening on http://127.0.0.1:5"):
+        try:
+            endpoint(text)
