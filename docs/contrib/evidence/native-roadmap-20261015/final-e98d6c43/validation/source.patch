+def self_test():
+    valid = {"tokens": [4, 5], "tokens_predicted": 2, "truncated": False, "stop": True,
+             "stop_type": "limit", "stopped_limit": True, "stopped_eos": False, "stopped_word": False,
+             "id_slot": 0, "timings": {"cache_n": 0}}
