+#[inline(always)]
+fn lane_dot(a: &[f32; 16], b: &[f32; 16]) -> f32 {
+    let mut p = [a[0] * b[0], a[1] * b[1], a[2] * b[2], a[3] * b[3]];
+    for i in 4..16 {
+        p[i % 4] = fma(a[i], b[i], p[i % 4]);
+    }
+    (p[0] + p[1]) + (p[2] + p[3])
