+#[unsafe(no_mangle)]
+pub unsafe extern "gpu-kernel" fn bloomery_hip_gdn_gate(
+    x: *const f32,
+    z: *const f32,
+    gain: *const f32,
+    out: *mut f32,
+    n_v: u32,
+    eps: f32,
+    fault: *mut u32,
