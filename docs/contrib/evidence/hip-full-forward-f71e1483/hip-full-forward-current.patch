+        .flat_map(|c| [0.11 + (c % 3) as f32 * 0.01, -0.19, 0.31, 0.43])
+        .collect();
+    let gain: Vec<_> = (0..HEAD).map(|i| 0.7 + (i % 13) as f32 * 0.025).collect();
+    let bias = signal(nv, 5, 0.006);
